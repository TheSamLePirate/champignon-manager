{
  "name": "champignon-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gestion et tra\u00e7abilit\u00e9 de la culture de champignons, du spore \u00e0 l'assiette.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "typecheck": "tsc --build --verbose",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "db:up": "docker compose -f docker/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f docker/docker-compose.yml down -v",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run test:coverage && bun run test:mutation",
    "clean": "rm -rf node_modules coverage reports **/dist **/*.tsbuildinfo",
    "api:dev": "bun run --filter '@champi/api' dev",
    "api:start": "bun run --filter '@champi/api' start",
    "web:dev": "bun run --filter '@champi/web' dev",
    "e2e": "playwright test",
    "build": "bun run --filter '@champi/web' build && bun run --filter '@champi/api' build:server && bun run --filter '@champi/cli' build",
    "start": "node packages/api/dist/server.mjs",
    "e2e:report": "playwright show-report reports/e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.18.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.2.1",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@hono/zod-openapi": "^1.5.2",
    "hono": "^4.13.1",
    "mongodb": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
